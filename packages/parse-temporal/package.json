    "url": "https://github.com/macalinao/temporal-utils/issues"
  },
  "keywords": [
    "temporal",
    "parse"
  ],
  "dependencies": {
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@macalinao/tsconfig": "catalog:",
