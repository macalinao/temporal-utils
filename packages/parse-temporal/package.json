{
  "name": "parse-temporal",
  "description": "Parse Temporal objects from strings.",
  "author": "Ian Macalinao <me@ianm.com>",
  "version": "0.5.3",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
