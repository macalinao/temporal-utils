{
  "name": "monorepo",
  "description": "Monorepo for TC39 Temporal utilities.",
  "private": true,
  "version": "0.0.1",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@macalinao/tsconfig": "^3.2.5",
      "@types/bun": "latest",
      "temporal-polyfill": "^0.3.0",
      "temporal-spec": "^0.3.0",
      "tslib": "^2.8.1",
      "typescript": "^7.0.2"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "watch": "turbo watch build",
    "test": "bun test src/",
    "test:cov": "bun test src/ --coverage",
    "typedoc": "typedoc",
    "ci:version": "changeset version && bun update",
    "ci:publish": "./scripts/ci-publish.sh"
  },
  "keywords": [],
  "author": "Ian Macalinao <me@ianm.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@changesets/cli": "^2.31.0",
    "@macalinao/biome-config": "^0.2.0",
    "turbo": "^2.10.0",
    "typedoc": "^0.28.19",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=22",
    "bun": ">=1.0.0"
  }
}
